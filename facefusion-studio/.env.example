# FaceFusion Studio — environment
#
# Copy to `.env.local` and adjust. Every value is optional: the defaults below
# are what `python facefusion.py api` exposes on a default install.

# Base URL of the FaceFusion v4 API server (defaults to --api-host/--api-port).
VITE_FF_API_BASE=http://127.0.0.1:8000

# Only sent when the server runs with FACEFUSION_API_KEY set.
VITE_FF_API_KEY=

# "auto" (default) talks to the server, falls back to the built-in demo
# backend when the server is unreachable. Force with "live" or "demo".
VITE_FF_TRANSPORT=auto

# Face landmarker model. Leave empty to use `public/models/face_landmarker.task`
# when present and the MediaPipe CDN otherwise.
VITE_FF_LANDMARKER_URL=

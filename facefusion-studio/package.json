{
  "name": "facefusion-studio",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "FaceFusion Studio \u2014 a zero-backend-modification client for the FaceFusion v4 API",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
